<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TReader.ViewModels"
        xmlns:views="using:TReader.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
        x:Class="TReader.Views.MainWindow"
        x:DataType="vm:ReaderViewModel"
        Title="TReader"
        Width="300"
        Height="400"
        MinWidth="120"
        MinHeight="120"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:ReaderViewModel/>
    </Design.DataContext>

    <!-- 阅读界面容器，用于控制透明度 -->
    <Grid x:Name="ContentContainer" Opacity="1">
        
        <views:ReaderView />

        <!-- 八方向缩放区域 -->
        <Border Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizePointerPressed"/>
        <Border Tag="North" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,0"
                Background="Transparent" Cursor="TopSide" PointerPressed="OnResizePointerPressed"/>
        <Border Tag="NorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizePointerPressed"/>

        <Border Tag="West" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,10"
                Background="Transparent" Cursor="LeftSide" PointerPressed="OnResizePointerPressed"/>
        <Border Tag="East" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,10"
                Background="Transparent" Cursor="RightSide" PointerPressed="OnResizePointerPressed"/>

        <Border Tag="SouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizePointerPressed"/>
        <Border Tag="South" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10,0"
                Background="Transparent" Cursor="BottomSide" PointerPressed="OnResizePointerPressed"/>
        <Border Tag="SouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizePointerPressed"/>
    </Grid>
    
</Window>
