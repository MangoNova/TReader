<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TReader.ViewModels"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="480"
        x:Class="TReader.Views.BookmarksWindow"
        x:DataType="vm:BookmarksViewModel"
        Title="书签"
        Icon="avares://TReader/Images/TReader.ico"
        Width="320"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:BookmarksViewModel/>
    </Design.DataContext>

    <Border Background="#1a1a2e"
            CornerRadius="12"
            Padding="16"
            BoxShadow="0 0 20 0 #66000000">

        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
                <TextBlock Text="书签" FontSize="18" FontWeight="Bold" Foreground="#eee" VerticalAlignment="Center"/>
                <Button Command="{Binding CloseCommand}" HorizontalAlignment="Right" Background="Transparent" Padding="4">
                    <TextBlock Text="✕" Foreground="#666"/>
                </Button>
            </Grid>

            <!-- Search -->
            <TextBox Grid.Row="1"
                     Text="{Binding SearchText}"
                     Watermark="搜索书签..."
                     Background="#252538"
                     Foreground="#eee"
                     BorderThickness="0"
                     CornerRadius="6"
                     Padding="8,6"
                     FontSize="12"
                     Margin="0,0,0,12"/>

            <!-- Bookmark List -->
            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding FilteredBookmarks}"
                         SelectedItem="{Binding SelectedBookmark}"
                         Background="Transparent"
                         BorderThickness="0"
                         x:Name="BookmarkListBox"
                         DoubleTapped="OnListBoxDoubleTapped"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Title}" Foreground="#ddd" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="#777" FontSize="10">
                                    <Run Text="{Binding ChapterTitle}"/>
                                    <Run Text=" · 第 "/>
                                    <Run Text="{Binding DisplayLineNumber}"/>
                                    <Run Text=" 行"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="暂无书签"
                           Foreground="#777"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !HasBookmarks}"/>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Content="删除"
                        Command="{Binding DeleteBookmarkCommand}"
                        Background="#5a2430"
                        Foreground="#ff8a8a"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,8"
                        CornerRadius="6"
                        IsEnabled="{Binding CanOperate}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="1"
                        Content="跳转"
                        Command="{Binding GoToBookmarkCommand}"
                        Background="#22b573"
                        Foreground="White"
                        HorizontalContentAlignment="Center"
                        Padding="24,8"
                        CornerRadius="6"
                        IsEnabled="{Binding CanOperate}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
